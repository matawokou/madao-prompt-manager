{
  "manifest_version": 3,
  "name": "Prompt Manager",
  "version": "2.1.3",
  "description": "提示词管理器：增删改查、搜索、导入导出、侧边栏快速调用、本地文件夹同步",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prompt Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "manager.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-sidepanel": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "打开提示词侧边栏"
    },
    "open-manager": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "打开提示词管理页"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}